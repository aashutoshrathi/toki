<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Toki</AssemblyName>
    <RootNamespace>Toki.Windows</RootNamespace>
    <Version>4.0.0-preview.3</Version>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <ApplicationIcon>Toki.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Toki.ico" LogicalName="Toki.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Toki.Core\Toki.Core.csproj" />
  </ItemGroup>
</Project>
